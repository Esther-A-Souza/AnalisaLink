{
  "info": {
    "name": "AnalisaLink API",
    "description": "Coleção da Etapa 06. Ligue a API com npm start e rode a pasta Operações na ordem.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Operações",
      "item": [
        {
          "name": "1. Criar análise (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"http://192.168.0.10/login\",\n  \"observacao\": \"Recebido por e-mail\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Tem Location\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.collectionVariables.set(\"id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Listar análises (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"É uma lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Listar com filtros (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analises?classificacao=Suspeita&busca=login&ordem=asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises"
              ],
              "query": [
                {
                  "key": "classificacao",
                  "value": "Suspeita"
                },
                {
                  "key": "busca",
                  "value": "login"
                },
                {
                  "key": "ordem",
                  "value": "asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Consultar análise (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analises/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises",
                "{{id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Mesmo id\", () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"id\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Substituir análise (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analises/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises",
                "{{id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"http://banco@site-falso.com/conta/verify\",\n  \"observacao\": \"URL corrigida\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Recalculou a pontuação\", () => pm.expect(pm.response.json().score).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Alterar parcialmente (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analises/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises",
                "{{id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"observacao\": \"Confirmado como golpe\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Observação alterada\", () => pm.expect(pm.response.json().observacao).to.eql(\"Confirmado como golpe\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Excluir análise (DELETE)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analises/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises",
                "{{id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Consultar excluída (GET) — esperado 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analises/{{id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises",
                "{{id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Erros",
      "item": [
        {
          "name": "URL inválida (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"exemplo.com\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Código VALIDACAO\", () => pm.expect(pm.response.json().erro.codigo).to.eql(\"VALIDACAO\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "JSON malformado (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{url:"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Content-Type incorreto (415)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"url\":\"https://exemplo.com\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 415\", () => pm.response.to.have.status(415));"
                ]
              }
            }
          ]
        },
        {
          "name": "Id inválido (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analises/abc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises",
                "abc"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH sem campos (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analises/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtro inválido (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analises?classificacao=Perigosa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises"
              ],
              "query": [
                {
                  "key": "classificacao",
                  "value": "Perigosa"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Análise inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analises/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises",
                "999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rota inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Método não permitido (405)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "analises"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 405\", () => pm.response.to.have.status(405));",
                  "pm.test(\"Tem Allow\", () => pm.response.to.have.header(\"Allow\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
